{
  "name": "oh-my-joy",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling for the oh-my-joy Claude Code plugin. The plugin itself ships no runtime dependencies \u2014 this manifest exists solely to run the validation suite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/hooks/*.test.mjs",
    "release": "node scripts/release.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs tests/hooks/*.test.mjs",
    "validate-plugin": "node scripts/validate-plugin.mjs",
    "eval": "node scripts/eval-runner.mjs"
  },
  "license": "MIT"
}
