{
  "name": "oh-my-joy",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Standalone Claude Code and Codex workflows with a Node-built-in goal evidence helper and validation suite; no runtime dependencies.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/hooks/*.test.mjs",
    "release": "node scripts/release.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs tests/hooks/*.test.mjs",
    "validate-plugin": "node scripts/validate-plugin.mjs",
    "eval": "node scripts/eval-runner.mjs"
  },
  "license": "MIT"
}
